{
  "include": [
    "frontend/src/**/*",
    "shared/**/*",
    "backend/**/*",
    "api/**/*",
    "tests/**/*",
    "scripts/**/*",
    "*.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["frontend/src/*"],
      "@shared/*": ["shared/*"]
    },
    "noUnusedLocals": true
  }
}
