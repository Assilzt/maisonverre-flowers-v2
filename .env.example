# Create an isolated V2 Neon database/branch. Never point migrations at V1 first.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-session-secret
TELEGRAM_BOT_TOKEN=replace-with-server-side-token
TELEGRAM_CHAT_ID=replace-with-chat-id
# Authenticates GET /api/jobs from Vercel Cron or an external scheduler.
CRON_SECRET=replace-with-a-long-random-scheduler-secret
