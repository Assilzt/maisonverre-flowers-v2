{
  "name": "maisonverre-platform",
  "version": "2.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.osen.local --import tsx scripts/dev.ts",
    "build": "vite build && tsx scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.osen.local --import tsx backend/dev-server.ts",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "format": "prettier --write frontend backend api database shared scripts tests docs skills .github *.ts *.json *.md",
    "dev:fixture": "node --import tsx scripts/dev.ts --fixture",
    "format:check": "prettier --check frontend backend api database shared scripts tests docs skills .github *.ts *.json *.md",
    "osen:check": "node --env-file=.env.osen.local --import tsx scripts/check-osen.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/functions": "^3.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/express": "4.17.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vite": "^7.3.7",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.4.1",
  "private": true,
  "description": "Private MaisonVerre storefront, order CRM and carrier operations platform",
  "engines": {
    "node": ">=22.6"
  },
  "pnpm": {
    "overrides": {
      "zod@<4.6.6": "^4.6.7"
    }
  }
}
